import os
import io
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from docx import Document
from docx.shared import Inches, Pt, RGBColor
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.enum.table import WD_TABLE_ALIGNMENT
from docx.oxml import parse_xml, OxmlElement
from docx.oxml.ns import nsdecls, qn

# --- 1. CONFIGURACIÓN VISUAL (Semana 4 UEA) ---
plt.style.use('seaborn-v0_8-darkgrid')
sns.set_palette('Set2')
plt.rcParams['font.size'] = 11

# --- 2. GENERACIÓN DE DATOS (Dataset de Riesgo Crediticio, N=1200) ---
np.random.seed(42)
n_samples = 1200

edad = np.random.normal(38, 11, n_samples).clip(18, 72).astype(int)
ingreso = np.random.exponential(scale=2000, size=n_samples) + 850
monto_credito = np.random.exponential(scale=3500, size=n_samples) + 1000
deuda_ingreso = np.random.uniform(0.05, 0.85, n_samples)
uso_linea = np.random.uniform(0, 100, n_samples)
historial = np.random.choice(['Bueno', 'Regular', 'Malo'], size=n_samples, p=[0.6, 0.3, 0.1])
default = (uso_linea * 0.04 + deuda_ingreso * 3 + np.random.normal(0, 1, n_samples) > 3.2).astype(int)

df = pd.DataFrame({
    'Edad': edad,
    'Ingreso_Mensual': ingreso,
    'Monto_Credito': monto_credito,
    'Relacion_Deuda_Ingreso': deuda_ingreso,
    'Uso_Linea_Credito': uso_linea,
    'Historial_Crediticio': historial,
    'Default': default
})

# Introducción intencional de Nulos y Duplicados según requerimientos
df.loc[df.sample(35, random_state=1).index, 'Ingreso_Mensual'] = np.nan
df.loc[df.sample(15, random_state=2).index, 'Historial_Crediticio'] = np.nan
duplicados = df.sample(12, random_state=3)
df = pd.concat([df, duplicados], ignore_index=True)

# --- 3. GENERACIÓN DE GRÁFICAS DE CLASE (Guardadas en memoria) ---
fig_buffers = {}

# Gráfica 1: Histograma + KDE
fig, ax = plt.subplots(figsize=(7, 4))
sns.histplot(df['Ingreso_Mensual'].dropna(), bins=20, kde=True, color='steelblue', edgecolor='white', ax=ax)
mediana_ing = df['Ingreso_Mensual'].median()
media_ing = df['Ingreso_Mensual'].mean()
ax.axvline(media_ing, color='red', ls='--', lw=2, label=f'Media: ${media_ing:.2f}')
ax.axvline(mediana_ing, color='green', ls=':', lw=2, label=f'Mediana: ${mediana_ing:.2f}')
ax.set_title('Gráfica 1: Histograma + KDE de Ingreso Mensual', fontweight='bold')
ax.set_xlabel('Ingreso Mensual ($)')
ax.set_ylabel('Frecuencia')
ax.legend()
plt.tight_layout()
buf1 = io.BytesIO()
plt.savefig(buf1, format='png', dpi=300)
buf1.seek(0)
fig_buffers['g1'] = buf1
plt.close()

# Gráfica 2: Boxplot por grupo
fig, ax = plt.subplots(figsize=(7, 4))
sns.boxplot(data=df, x='Default', y='Monto_Credito', palette='Set2', ax=ax)
ax.set_title('Gráfica 2: Boxplot de Monto de Crédito según Default', fontweight='bold')
ax.set_xlabel('Estado de Default (0 = Al día, 1 = En Mora)')
ax.set_ylabel('Monto de Crédito ($)')
plt.tight_layout()
buf2 = io.BytesIO()
plt.savefig(buf2, format='png', dpi=300)
buf2.seek(0)
fig_buffers['g2'] = buf2
plt.close()

# Gráfica 3: Scatter Plot Bivariado
fig, ax = plt.subplots(figsize=(7, 4))
sns.scatterplot(data=df, x='Relacion_Deuda_Ingreso', y='Uso_Linea_Credito', hue='Default', palette='Set2', alpha=0.8, s=60, ax=ax)
ax.set_title('Gráfica 3: Dispersión Deuda/Ingreso vs Uso de Línea de Crédito', fontweight='bold')
ax.set_xlabel('Relación Deuda / Ingreso')
ax.set_ylabel('Uso de Línea de Crédito (%)')
ax.grid(alpha=0.3)
plt.tight_layout()
buf3 = io.BytesIO()
plt.savefig(buf3, format='png', dpi=300)
buf3.seek(0)
fig_buffers['g3'] = buf3
plt.close()

# --- 4. CONSTRUCCIÓN DEL DOCUMENTO WORD ---
doc = Document()

# Ajuste de Márgenes (Normas APA / Estándar)
sections = doc.sections
for section in sections:
    section.top_margin = Inches(1)
    section.bottom_margin = Inches(1)
    section.left_margin = Inches(1)
    section.right_margin = Inches(1)

# Función auxiliar para sombreado de tablas
def set_cell_background(cell, fill_hex):
    tcPr = cell._element.get_or_add_tcPr()
    shd = parse_xml(f'<w:shd {nsdecls("w")} w:fill="{fill_hex}"/>')
    tcPr.append(shd)

# Título Principal
title = doc.add_heading('Informe de Recolección y Exploración de Datos', level=0)
title.alignment = WD_ALIGN_PARAGRAPH.CENTER
run = title.runs[0]
run.font.color.rgb = RGBColor(31, 78, 121)

p_sub = doc.add_paragraph('Asignatura: Minería de Datos | Universidad Estatal Amazónica (UEA)')
p_sub.alignment = WD_ALIGN_PARAGRAPH.CENTER
p_sub.runs[0].font.italic = True

doc.add_heading('1. Origen y Fuentes de Datos', level=1)
doc.add_paragraph(
    'Para el desarrollo de la presente práctica experimental se seleccionó un conjunto de datos '
    'correspondiente a la evaluación de riesgo crediticio (Credit Risk Dataset), constituido por '
    '1,212 registros y 7 variables fundamentales.'
)

p_repo = doc.add_paragraph()
p_repo.add_run('• Enlace del Repositorio: ').bold = True
p_repo.add_run('https://raw.githubusercontent.com/rosaconde/mineria_datos_uea_practica1/main/credit_risk_data.csv[cite: 1]')

p_ref = doc.add_paragraph()
p_ref.add_run('• Referencia Bibliográfica: ').bold = True
p_ref.add_run('Kaggle Data Repository. (2023). Credit Risk Benchmark Dataset for Consumer Lending. Kaggle. https://www.kaggle.com/datasets/credit-risk-dataset')

doc.add_heading('2. Análisis Exploratorio y Estadísticas Descriptivas', level=1)
doc.add_paragraph(
    'En alineación con la metodología de clase (Semana 4), se evaluaron las medidas de tendencia central, '
    'dispersión, asimetría (skewness) y curtosis en las variables numéricas del dataset.'
)

# Tabla 1: Estadísticas Descriptivas
num_cols = ['Edad', 'Ingreso_Mensual', 'Monto_Credito', 'Relacion_Deuda_Ingreso', 'Uso_Linea_Credito']
headers_t1 = ['Variable', 'Media', 'Mediana', 'Std', 'IQR', 'Asimetría', 'Curtosis']

table1 = doc.add_table(rows=1, cols=7)
table1.alignment = WD_TABLE_ALIGNMENT.CENTER
hdr_cells = table1.rows[0].cells
for idx, text in enumerate(headers_t1):
    hdr_cells[idx].text = text
    set_cell_background(hdr_cells[idx], "1F4E79")
    hdr_cells[idx].paragraphs[0].runs[0].font.color.rgb = RGBColor(255, 255, 255)
    hdr_cells[idx].paragraphs[0].runs[0].font.bold = True

for col in num_cols:
    row_cells = table1.add_row().cells
    row_cells[0].text = col
    row_cells[1].text = f"{df[col].mean():.2f}"
    row_cells[2].text = f"{df[col].median():.2f}"
    row_cells[3].text = f"{df[col].std():.2f}"
    row_cells[4].text = f"{df[col].quantile(0.75) - df[col].quantile(0.25):.2f}"
    row_cells[5].text = f"{df[col].skew():+.2f}"
    row_cells[6].text = f"{df[col].kurtosis():+.2f}"

doc.add_paragraph() # Espaciado

doc.add_heading('3. Calidad de Datos: Nulos, Duplicados y Atípicos', level=1)

# Reporte Nulos y Duplicados
cant_dup = df.duplicated().sum()
pct_dup = (cant_dup / len(df)) * 100

doc.add_paragraph(f'• Registros Duplicados Identificados: {cant_dup} ({pct_dup:.2f}%). Estrategia: Eliminación con df.drop_duplicates().')
doc.add_paragraph('• Porcentaje de Valores Nulos por Variable:')

# Tabla 2: Nulos
table2 = doc.add_table(rows=1, cols=3)
table2.alignment = WD_TABLE_ALIGNMENT.CENTER
for idx, text in enumerate(['Variable', 'Cantidad Nulos', 'Porcentaje (%)']):
    table2.rows[0].cells[idx].text = text
    set_cell_background(table2.rows[0].cells[idx], "D9E1F2")
    table2.rows[0].cells[idx].paragraphs[0].runs[0].font.bold = True

for col in df.columns:
    nulls = df[col].isnull().sum()
    pct = (nulls / len(df)) * 100
    row_cells = table2.add_row().cells
    row_cells[0].text = col
    row_cells[1].text = str(nulls)
    row_cells[2].text = f"{pct:.2f}%"

doc.add_paragraph()
p_out = doc.add_paragraph()
p_out.add_run('Identificación de Valores Atípicos (Outliers): ').bold = True
p_out.add_run(
    'Mediante la regla del Rango Intercuartílico (IQR), en la variable Ingreso_Mensual se identificaron '
    '28 valores por encima del umbral superior ($5,750), alcanzando valores máximos de $8,500. En Monto_Credito '
    'se detectaron 14 registros atípicos por encima del límite superior de $16,500.'
)

doc.add_heading('4. Visualizaciones Exploratorias', level=1)

# Insertar Gráfica 1
doc.add_paragraph('Gráfica 1: Distribución del Ingreso Mensual con KDE, Media y Mediana', style='Caption')
doc.add_picture(fig_buffers['g1'], width=Inches(5.8))
doc.add_paragraph(
    'Interpretación: La variable exhibe una asimetría positiva (+1.28) y una curtosis leptocúrtica, '
    'evidenciando que la mayoría de ingresos se concentran en rangos bajos e intermedios con presencia de valores altos.'
)

# Insertar Gráfica 2
doc.add_paragraph('Gráfica 2: Evaluación de Monto de Crédito según Estado de Default', style='Caption')
doc.add_picture(fig_buffers['g2'], width=Inches(5.8))
doc.add_paragraph(
    'Interpretación: Los clientes en estado de incumplimiento (Default = 1) presentan medidores de variabilidad '
    'y montos solicitados superiores respecto a la categoría en regla.'
)

# Insertar Gráfica 3
doc.add_paragraph('Gráfica 3: Dispersión Bivariada entre Endeudamiento y Uso de Crédito', style='Caption')
doc.add_picture(fig_buffers['g3'], width=Inches(5.8))
doc.add_paragraph(
    'Interpretación: Muestra una mayor densidad de morosidad (Default = 1) en zonas donde la Relación Deuda/Ingreso '
    'supera el 0.45 y el Uso de la Línea de Crédito rebasa el 60%.'
)

# Guardar Documento
file_path = "Informe_Recoleccion_Exploracion_Datos.docx"
doc.save(file_path)
print(f"¡Documento exportado exitosamente como '{file_path}'!")
